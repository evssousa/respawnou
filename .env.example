# Copie para .env (o .env nunca vai para o Git). Na Hostinger, cadastre as mesmas
# variáveis no painel do app Node.js.

# URL pública do site (canonical, Open Graph, sitemap e RSS). Usada no build.
VITE_SITE_URL=https://respawnou.com.br

# MySQL. Sem DB_NAME/DB_USER o site usa os dados de exemplo (mock-data.ts).
# Na Hostinger: host 127.0.0.1 (nunca o srvNNNN.hstgr.io).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Próximas fases (robô e admin):
# CRON_TOKEN=
# GEMINI_API_KEY=
# RAWG_API_KEY=
# YOUTUBE_API_KEY=   (opcional: trailer quando a fonte não tem vídeo)
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=
# Pasta das imagens das matérias (padrão: ~/respawnou-media)
# MEDIA_DIR=
