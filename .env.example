# Copie para .env (o .env nunca vai para o Git). Na VPS, cadastre as mesmas
# variáveis no app do Coolify (só VITE_SITE_URL como Build Variable).

# URL pública do site (canonical, Open Graph, sitemap e RSS). Usada no build.
VITE_SITE_URL=https://respawnou.com.br

# MySQL. Sem DB_NAME/DB_USER o site usa os dados de exemplo (mock-data.ts).
# Na VPS: DB_HOST = nome interno do serviço MariaDB no Coolify.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Próximas fases (robô e admin):
# CRON_TOKEN=
# GEMINI_API_KEY=
# RAWG_API_KEY=
# YOUTUBE_API_KEY=   (opcional: trailer quando a fonte não tem vídeo)
# ADSENSE_CLIENT=    (opcional: ca-pub-… do AdSense; liga anúncios, ads.txt e banner de cookies)
# IGDB_CLIENT_ID=      (fichas de jogos e lançamentos)
# IGDB_CLIENT_SECRET=
# ELEVENLABS_API_KEY=  (voz dos vídeos curtos)
# SOCIAL_KEY=          (64 hex: cifra o token do Instagram no banco; trocar a chave obriga a colar o token de novo)
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=   (gerado com `npm run admin:hash`, nunca a senha)
# SESSION_SECRET=
# Pasta das imagens das matérias (padrão: ~/respawnou-media; na VPS o Dockerfile define /data/media)
# MEDIA_DIR=
